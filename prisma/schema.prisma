datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. เพิ่ม Enum สำหรับเพศ
enum Gender {
  MALE
  FEMALE
  OTHER
}

// 2. ตารางผู้ใช้งานและสิทธิ์
model User {
  id        Int      @id @default(autoincrement())
  firstName String   @map("first_name")
  lastName  String   @map("last_name")
  idCard    String   @unique @map("id_card")
  phone     String
  email     String   @unique
  password  String
  gender    Gender?  @default(MALE) 
  role      Role     @default(PATIENT)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  doctor         Doctor?
  appointments   Appointment[]   @relation("PatientAppointments")


  @@map("users")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

// 3. ตารางแผนกการรักษา
model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  doctors      Doctor[]
  appointments Appointment[]

  @@map("departments")
}

model Doctor {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique @map("user_id")
  departmentId     Int      @map("department_id")
  licenseNumber    String   @unique @map("license_number")
  specialization   String
  bio              String?
  isInstantBooking Boolean  @default(false) @map("is_instant_booking")
  createdAt        DateTime @default(now()) @map("created_at")

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department     Department       @relation(fields: [departmentId], references: [id])
  schedules      DoctorSchedule[]
  appointments   Appointment[]
 

  @@map("doctors")
}

// 5. ตารางเวลาเข้าตรวจของแพทย์
model DoctorSchedule {
  id        Int    @id @default(autoincrement())
  doctorId  Int    @map("doctor_id")
  dayOfWeek Int    @map("day_of_week") // 0=Sun, 1=Mon, ..., 6=Sat
  startTime String @map("start_time")  // เช่น "09:00"
  endTime   String @map("end_time")    // เช่น "16:00"
  maxSlots  Int    @default(20) @map("max_slots")

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@map("doctor_schedules")
}

// 6. ตารางการนัดหมาย / จองคิว
model Appointment {
  id              Int               @id @default(autoincrement())
  patientId       Int               @map("patient_id")
  doctorId        Int?              @map("doctor_id")
  departmentId    Int               @map("department_id")
  branch          String            @default("novaria-main") @map("branch") 
  appointmentDate DateTime          @db.Date @map("appointment_date") 
  timeSlot        String            @map("time_slot")                   
  symptoms        String?
  status          AppointmentStatus @default(PENDING)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  patient       User        @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor        Doctor?     @relation(fields: [doctorId], references: [id])
  department    Department  @relation(fields: [departmentId], references: [id])
  

  @@map("appointments")
}

model News {
  id        Int      @id @default(autoincrement())
  title     String
  content   String   @db.Text
  category  String
  imageUrl  String?  @map("image_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("news")
}

model Package {
  id            Int      @id @default(autoincrement())
  title         String
  subtitle      String?
  category      String
  price         String   // เช่น "3,500 ฿" หรือ "3500"
  originalPrice String?  // เช่น "6,000 ฿"
  tag           String?  // เช่น "Special Offer"
  imageUrl      String?  @map("image_url")
  features      String[] // Array ของรายการคุณสมบัติ/รายละเอียดเพิ่มเติม
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("packages")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

